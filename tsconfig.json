{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "supabase/functions/**/*.ts", "vitest.config.ts"],
  "exclude": ["supabase/functions/*/dist"]
}
